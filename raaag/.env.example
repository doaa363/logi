# ── Server ──────────────────────────────────
PORT=3000
NODE_ENV=development

# ── RAG Module Toggle (set true only if Qdrant + Redis are running) ──────────
ENABLE_RAG=false

# ── MongoDB ────────────────────────────────
MONGODB_URI=mongodb://admin:password@localhost:27017/logiCore_rag?authSource=admin

# ── RAG Core ──────────────────────────────
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_LLM_PROVIDER=openai
RAG_LLM_API_KEY=your_openai_api_key_here
RAG_LLM_MODEL=gpt-4-turbo

# ── Vector DB ─────────────────────────────
RAG_VECTOR_DB_TYPE=qdrant
RAG_VECTOR_DB_URL=http://localhost:6333
RAG_VECTOR_DB_API_KEY=
RAG_VECTOR_INDEX_NAME=logiCore_embeddings
RAG_VECTOR_DIMENSIONS=1536

# ── Cache ──────────────────────────────────
RAG_REDIS_URL=redis://localhost:6379
RAG_CACHE_TTL_SECONDS=300

# ── Multi‑modal ───────────────────────────
RAG_ASSEMBLYAI_API_KEY=
RAG_TESSERACT_LANG=ara+eng

# ── Cross‑Encoder ─────────────────────────
RAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Directories ───────────────────────────
REPORTS_DIR=./reports
UPLOADS_DIR=./uploads/incidents
