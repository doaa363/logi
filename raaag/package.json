{
  "name": "logiCore-rag",
  "version": "1.0.0",
  "description": "RAG system for LogiCore Operational Command Center",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "start:prod": "NODE_ENV=production node dist/app.js",
    "dev": "nodemon --exec ts-node src/app.ts",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --passWithNoTests --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "rag:seed": "ts-node src/scripts/seedRAG.ts"
  },
  "dependencies": {
    "@pinecone-database/pinecone": "^1.1.0",
    "@qdrant/js-client-rest": "^1.8.0",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "assemblyai": "^4.0.0",
    "bullmq": "^5.0.0",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "lodash": "^4.17.21",
    "mongoose": "^8.0.0",
    "multer": "^2.2.0",
    "node-cron": "^3.0.0",
    "openai": "^4.28.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.14.0",
    "redis": "^4.6.10",
    "socket.io": "^4.7.0",
    "socket.io-client": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^5.0.4",
    "uuid": "^9.0.0"
