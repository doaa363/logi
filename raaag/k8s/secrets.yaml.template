# ⚠️  DO NOT COMMIT THIS FILE WITH REAL VALUES ⚠️
# This is a template. Populate with real secrets and apply via:
#   kubectl apply -f k8s/secrets.yaml -n logiCore
# Or use a secret manager (Vault, AWS Secrets Manager, GCP Secret Manager).

apiVersion: v1
kind: Secret
metadata:
  name: mongodb-secret
  namespace: logiCore
type: Opaque
stringData:
  uri: "mongodb://admin:password@mongodb-service:27017/logiCore_rag?authSource=admin"
---
apiVersion: v1
kind: Secret
metadata:
  name: openai-secret
  namespace: logiCore
type: Opaque
stringData:
  apiKey: "sk-your-openai-api-key"
---
apiVersion: v1
kind: Secret
metadata:
  name: jwt-secret
  namespace: logiCore
type: Opaque
stringData:
  secret: "your-very-secure-jwt-secret"
---
apiVersion: v1
kind: Secret
metadata:
  name: assemblyai-secret
  namespace: logiCore
type: Opaque
stringData:
  apiKey: "your-assemblyai-api-key"
